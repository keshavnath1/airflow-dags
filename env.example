# Environment Variables for ML Pipeline with RAG Support
# Copy this file to .env and update the values as needed

# Airflow Configuration
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ML Pipeline Configuration
ML_ENGINE=dask                    # Options: dask, spark, ray
MODEL_TYPE=traditional            # Options: traditional, rag
RAG_TYPE=adaptive                 # Options: adaptive, corrective, self-rag (only for RAG models)
RAG_APPROACH=lightweight          # Options: lightweight, transformer
NUM_SAMPLES=1000                  # Number of synthetic samples to generate
EVALUATE_MODEL=true               # Whether to run evaluation after training
SKIP_SECURITY=false               # Whether to skip security scanning
SKIP_PUBLISH=true                 # Whether to skip publishing to Hugging Face (set to false for production)

# Data Configuration
DATA_PATH=/app/data/training_data.parquet
OUTPUT_DIR=/app/outputs

# Hugging Face Configuration (for model publishing)
HF_TOKEN=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

# Docker Configuration
DOCKER_IMAGE=ml-pipeline-rag:latest

# Development Configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1

